  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "typesafe",
    "jev",
    "claude-code",
    "codex"
  ],
  "author": "Pedro Ramos Pereira",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroRamosPereira/choose-mcp.git"
  },
  "type": "module",
  "bin": {
    "choose-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/e2e.mjs",
    "calibrate": "npm run build && node scripts/calibrate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
