{
  "mcpServers": {
    "choose": {
      "command": "npx",
      "args": ["-y", "choose-mcp"],
      "env": {
        "CHOOSE_LLM_MODEL": "${user_config.llm_model}",
        "CHOOSE_LLM_BASE_URL": "${user_config.llm_base_url}",
        "CHOOSE_LLM_API_KEY": "${user_config.llm_api_key}",
        "TYPESAFE_API_KEY": "${user_config.typesafe_api_key}"
      }
    }
  }
}
